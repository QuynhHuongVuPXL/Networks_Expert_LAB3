<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">

  <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">

    <!-- Hostname -->
    <hostname>CSR1kv-NETCONF</hostname>

    <!-- Interfaces -->
    <interface>

      <Loopback>
        <name>10</name>
        <description>NETCONF Loopback10</description>
        <ip>
          <address>
            <primary>
              <address>10.10.10.10</address>
              <mask>255.255.255.255</mask>
            </primary>
          </address>
        </ip>
      </Loopback>

      <Loopback>
        <name>11</name>
        <description>NETCONF Loopback11</description>
        <ip>
          <address>
            <primary>
              <address>10.11.11.11</address>
              <mask>255.255.255.255</mask>
            </primary>
          </address>
        </ip>
      </Loopback>

    </interface>

    <!-- OSPF (YANG-native, compatible with IOS-XE) -->
    <router>
      <ospf xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-ospf">

        <id>1</id>
        <router-id>1.1.1.1</router-id>

        <network>
          <ip>10.10.10.10</ip>
          <mask>0.0.0.0</mask>
          <area>0</area>
        </network>

        <network>
          <ip>10.11.11.11</ip>
          <mask>0.0.0.0</mask>
          <area>0</area>
        </network>

      </ospf>
    </router>

  </native>

</config>
